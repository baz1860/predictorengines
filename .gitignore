# Local command-center/runtime state: SQLite databases, WAL files, caches,
# and backups are generated on launch and must not be versioned.
config/

# Local app settings may contain API keys.
data/app_settings.json
data/api_keys.json

# Point-in-time prediction snapshots are a local, append-only record.
# The committed template is data/prediction_snapshots.example.csv.
data/prediction_snapshots.csv

# Point-in-time edge/value-bet recommendation snapshots (local record).
# The committed template is data/edge_snapshots.example.csv.
data/edge_snapshots.csv

