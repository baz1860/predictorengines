plans/international-refactor-plan.md

# Club Soccer raw API/HTTP response caches (regenerated on demand; thousands
# of small per-request files, not meant to be versioned).
club_soccer/data/bsd_cache/
club_soccer/data/weather_cache/
club_soccer/data/fdcouk_cache/
club_soccer/data/clubelo_cache/
# Player-appearance cache: derived from bsd_cache, huge (pretty-printed JSON
# per player), and rebuildable via `python3 -m club_soccer.player_features
# --refresh` or `--from-cache`. Not meant to be versioned either.
club_soccer/data/player_stats_cache.json

# ═══════════════════════════════════════════════════════════════════════════
# Per-instance run artifacts. The line: code, curated/reference data, seed
# datasets and fitted model params stay in git; anything a run FETCHES from a
# provider, ACCUMULATES as local state, or RENDERS as output stays local.
# ═══════════════════════════════════════════════════════════════════════════

# Raw provider payloads — live_data._save_raw() writes every fetch as
# {provider}_{kind}_{timestamp}.json here (bsd_event_*, bsd_events_*,
# the-odds-api_markets_*, and any future provider). Local audit trail only.
data/worldcup/raw/

